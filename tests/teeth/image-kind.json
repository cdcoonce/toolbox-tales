    {
      "label": "2 candidate extension always .png",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "path = stem.with_suffix(_KIND_EXT[kind])",
      "replace": "path = stem.with_suffix(\".png\")"
    },
    {
      "label": "3 jpeg candidate named .jpeg",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "\"jpeg\": \".jpg\", \"webp\": \".webp\"}\n_SUFFIX_KIND",
      "replace": "\"jpeg\": \".jpeg\", \"webp\": \".webp\"}\n_SUFFIX_KIND"
    },
    {
      "label": "4 numbering counts only .png",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "_CANDIDATE = re.compile(r\"^c(\\d{2,})\\.[^.]+$\")",
      "replace": "_CANDIDATE = re.compile(r\"^c(\\d{2,})\\.png$\")"
    },
    {
      "label": "5 non-image ledger output gets .png",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "    if kind is None:\n            ledger.append(est, output=bare, actual_usd=est.cost_usd)",
      "replace": "    if kind is None:\n            ledger.append(est, output=f\"{bare}.png\", actual_usd=est.cost_usd)"
    },
    {
