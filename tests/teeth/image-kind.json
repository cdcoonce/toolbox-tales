{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "pytest",
    "-q",
    "tests"
  ],
  "collect_command": [
    "uv",
    "run",
    "pytest",
    "--collect-only",
    "-q",
    "tests"
  ],
  "mutants": [
    {
      "label": "1 candidate prompt carries the name again",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "f\"{style}. {personality} One character,",
      "replace": "f\"{style}. Character design sheet for {name}. {personality} One character,"
