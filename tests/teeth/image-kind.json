      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "if _SUFFIX_KIND.get(source.suffix.lower()) != kind:",
      "replace": "if False:"
    },
    {
      "label": "7 panels data URI type from suffix",
      "file": "../../src/toolbox_tales/panels.py",
      "oracle": "real",
      "find": "return f\"data:image/{kind};base64,",
      "replace": "return f\"data:image/{mime};base64,"
    },
    {
      "label": "8 panels skips junk reference bytes check",
      "file": "../../src/toolbox_tales/panels.py",
      "oracle": "real",
      "find": "    kind = _image_kind(data)\n    if kind is None:\n        raise fail(",
      "replace": "    kind = _image_kind(data)\n    if False:\n        raise fail("
    },
    {
      "label": "9 shot data URI type from suffix",
      "file": "../../src/toolbox_tales/shot.py",
      "oracle": "real",
      "find": "return f\"data:image/{kind};base64,",
      "replace": "return f\"data:image/{mime};base64,"
    },
    {
      "label": "10 shot skips junk start frame bytes check",
      "file": "../../src/toolbox_tales/shot.py",
      "oracle": "real",
      "find": "    kind = _image_kind(data)\n    if kind is None:\n        raise ShotError(",
      "replace": "    kind = _image_kind(data)\n    if False:\n        raise ShotError("
    },
    {
      "label": "11 sniffer requires WEBX at 8:12",
      "file": "../../src/toolbox_tales/panels.py",
      "oracle": "real",
      "find": "data[8:12] == b\"WEBP\"",
      "replace": "data[8:12] == b\"WEBX\""
    },
    {
      "label": "12 [control] approve mismatch message tail",
      "file": "../../src/toolbox_tales/cast.py",
      "oracle": "real",
      "find": "and try again\"",
      "replace": "and retry\"",
      "expect": "survived",
      "why": "No test pins the tail wording of the approve suffix/kind mismatch message; CastError is asserted without a match, so rewording the hint changes no behaviour under test."
